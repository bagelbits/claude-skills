{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/bard-filter.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\bard-filter.mjs\" }",
            "statusMessage": "comment-bard: scanning new comments for iambic pentameter…",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-pr-bard-check.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\pre-pr-bard-check.mjs\" }",
            "statusMessage": "comment-bard: scanning branch diff for iambic pentameter…",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(gh pr create*)",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-pr-bard-check.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\pre-pr-bard-check.mjs\" }",
            "statusMessage": "comment-bard: scanning branch diff for iambic pentameter…",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__plugin_github_github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-pr-bard-check.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\pre-pr-bard-check.mjs\" }",
            "statusMessage": "comment-bard: scanning branch diff for iambic pentameter…",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BARD RULE: every prose comment line in a code file must scan as iambic pentameter — exactly ten syllables. If one line in a /** ... */ block scans, every line in that block must. Shared markers (TODO, FIXME, NOTE, HACK, XXX, eslint/prettier/biome directives, @tags, bare URLs) are exempt, as is any bard: prefixed line for tokens that can never be metered. A PreToolUse hook blocks writes and commits that add unmetered prose.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
