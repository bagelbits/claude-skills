{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/reaper-filter.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\reaper-filter.mjs\" }",
            "statusMessage": "comment-reaper: checking new comments for what-not-why violations…",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-pr-reaper-check.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\pre-pr-reaper-check.mjs\" }",
            "statusMessage": "comment-reaper: checking branch diff for what-not-why violations…",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__plugin_github_github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-pr-reaper-check.mjs\" || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\pre-pr-reaper-check.mjs\" }",
            "statusMessage": "comment-reaper: checking branch diff for what-not-why violations…",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'COMMENT RULE: comment the non-obvious *why*, never the *what*. Prefer clear code over a comment; delete redundant/narrating ones. Use /** ... */ for multiline. A PreToolUse hook blocks writes that add obvious violations.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
